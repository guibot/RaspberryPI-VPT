#!/bin/bash
# Liga/desliga o modo kiosk (o Pi abre direto no player em vez do ambiente de trabalho).
#   ./kiosk on      a partir do próximo arranque
#   ./kiosk off     volta ao arranque normal
#   ./kiosk status  mostra o estado
# Só cria/apaga ~/.config/labwc/autostart. Nunca toca em /etc.
ROOT="$(cd "$(dirname "$0")" && pwd)"
FILE="$HOME/.config/labwc/autostart"
MARK="# gerido por ./kiosk"
managed() { [ -f "$FILE" ] && grep -q "$MARK" "$FILE"; }
case "$1" in
  on)
    if [ -f "$FILE" ] && ! managed; then echo "Já existe um $FILE que não foi criado por este script; não mexo nele." >&2; exit 1; fi
    mkdir -p "$(dirname "$FILE")"
    printf '%s\n# Apagar este ficheiro (ou ./kiosk off) repõe o arranque normal.\n%s/deploy/kiosk-session.sh &\n' "$MARK" "$ROOT" > "$FILE"
    echo "kiosk LIGADO: no próximo arranque o Pi abre direto no player."
    echo "Para voltar ao normal: $ROOT/kiosk off" ;;
  off)
    if managed; then rm -f "$FILE"; echo "kiosk DESLIGADO: o próximo arranque é normal."
    elif [ -f "$FILE" ]; then echo "$FILE existe mas não é nosso; não mexo nele." >&2; exit 1
    else echo "kiosk já estava desligado."; fi ;;
  status|"")
    if managed; then echo "kiosk: LIGADO (próximo arranque abre no player)"; else echo "kiosk: desligado"; fi ;;
  *) echo "uso: $0 on|off|status" >&2; exit 2 ;;
esac
